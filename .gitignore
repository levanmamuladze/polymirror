# ---------------------------------------------------------------------------
# Secrets and local configuration — NEVER commit these
# ---------------------------------------------------------------------------
# config.example.yaml is the committed template; config.yaml is the local,
# machine-specific copy (and may name/hold environment-specific settings).
config.yaml
config.*.yaml
!config.example.yaml

# Environment files that hold POLYMARKET_PRIVATE_KEY, CLOB API creds, etc.
.env
.env.*
!.env.example
*.key
*.pem
secrets.*

# ---------------------------------------------------------------------------
# Runtime state — local SQLite database, WAL/SHM sidecars, rotated logs
# ---------------------------------------------------------------------------
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
*.log.*

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# Test and tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code: share project settings, keep personal overrides local
.claude/settings.local.json
.claude/*.local.json

# ---------------------------------------------------------------------------
# OS clutter (OneDrive-synced folder)
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
